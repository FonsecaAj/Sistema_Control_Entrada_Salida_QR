@page
@model Sistema_Control_Entrada_Salida_QR.Pages.Modulo_Administradores.Activacion_Perfil.IndexModel
@{
    Layout = "Layout_Plantilla";
    ViewData["Title"] = "Activación de Perfiles";
}

<div class="formulario-body formulario-no-bg">

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="formulario-mensaje-alerta @(Model.EsExito ? "mensaje-exito" : "mensaje-error")">
            @Model.Mensaje
        </div>
    }

    <div class="formulario-tabla-container">
        <!-- ENCABEZADO -->
        <div class="formulario-tabla-header">
            <h2>Solicitudes de Registro Pendientes</h2>
            <div class="formulario-tabla-badge">
                PANEL DE ADMINISTRACIÓN
            </div>
        </div>

        <div class="formulario-tabla-content">
            <div class="formulario-table-wrapper">
                <table class="formulario-table">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Primer Apellido</th>
                            <th>Segundo Apellido</th>
                            <th>Identificación</th>
                            <th>Correo Institucional</th>
                            <th>Carrera/Programa</th>
                            <th>Estado</th>
                            <th>Fecha Registro</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var registro in Model.RegistrosPendientes)
                        {
                            <tr>
                                <td>@registro.Nombre</td>
                                <td>@registro.Primer_Apellido</td>
                                <td>@registro.Segundo_Apellido</td>
                                <td>@registro.Identificacion</td>
                                <td>@registro.Correo_Institucional</td>
                                <td>@registro.Carrera</td>
                                <td>
                                    <span class="formulario-badge-estado badge-pendiente">@registro.Estado</span>
                                </td>
                                <td>@registro.Fecha_Registro.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="formulario-acciones-cell">
                                        <form method="post" style="display:inline;">
                                            <input type="hidden" name="identificacion" value="@registro.Identificacion" />
                                            <input type="hidden" name="correo" value="@registro.Correo_Institucional" />
                                            <input type="hidden" name="decision" value="A" />
                                            <button type="submit" class="formulario-btn formulario-btn-sm formulario-btn-success"
                                                    asp-page-handler="Aprobar">
                                                <i class="fas fa-check me-1"></i> Activar
                                            </button>
                                        </form>
                                        <form method="post" style="display:inline;">
                                            <input type="hidden" name="identificacion" value="@registro.Identificacion" />
                                            <input type="hidden" name="decision" value="R" />
                                            <button type="submit" class="formulario-btn formulario-btn-sm formulario-btn-danger"
                                                    asp-page-handler="Rechazar">
                                                <i class="fas fa-times me-1"></i> Rechazar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>