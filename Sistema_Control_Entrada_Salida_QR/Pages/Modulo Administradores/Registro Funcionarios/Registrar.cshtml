@page
@model Sistema_Control_Entrada_Salida_QR.Pages.Modulo_Administradores.Registro_Funcionarios.RegistrarModel
@{
    Layout = "Layout_Plantilla";
    ViewData["Title"] = "Registro de Funcionarios";
}


<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

<div class="formulario-body formulario-no-bg">
    <div class="formulario-container" style="max-width: 720px;">

        <!-- ENCABEZADO -->
        <div class="formulario-header">
            <h1>Registro de Funcionarios</h1>
            <div class="formulario-badge">
                FORMULARIO OFICIAL
            </div>
        </div>

        <div class="formulario-body-content">

            @if (!string.IsNullOrEmpty(Model.Mensaje))
            {
                <div class="formulario-alert @(Model.Resultado ? "formulario-alert-success" : "formulario-alert-danger")">
                    @Model.Mensaje
                </div>
            }

            <form method="post" enctype="multipart/form-data">

               
                <!-- FOTO -->
                <div class="formulario-foto-container">
                    <div class="formulario-foto-preview">
                        <img id="previewFoto" src="https://cdn-icons-png.flaticon.com/512/3177/3177440.png" />
                    </div>

                    <label class="formulario-foto-btn">
                        <i class="fas fa-camera"></i>
                        <span>Subir Foto</span>
                        <input asp-for="Foto" type="file" accept="image/*"
                               class="formulario-file-input" onchange="previewImage(event)" />
                    </label>
                </div>

                <div class="formulario-row">

                    <!-- TIPO IDENTIFICACION -->
                    <div class="formulario-form-group">
                        <label class="formulario-label">Tipo de Identificación</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-list"></i>
                            <select asp-for="Funcionario.Id_Tipo_Identificacion"
                                    asp-items="Model.TiposIdentificacion"
                                    class="formulario-select"></select>
                        </div>
                    </div>

                    <!-- IDENTIFICACIÓN -->
                    <div class="formulario-form-group">
                        <label class="formulario-label">Identificación</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-id-card"></i>
                            <input asp-for="Funcionario.Identificacion" class="formulario-input" placeholder="Ingrese la identificación" />
                        </div>
                    </div>
                </div>

                <div class="formulario-row">

                    <!-- NOMBRE -->
                    <div class="formulario-form-group">
                        <label class="formulario-label">Nombre</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-user"></i>
                            <input asp-for="Funcionario.Nombre" class="formulario-input" placeholder="Ingrese el nombre" />
                        </div>
                    </div>

                    <!-- PRIMER APELLIDO -->
                    <div class="formulario-form-group">
                        <label class="formulario-label">Primer Apellido</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-user-tag"></i>
                            <input asp-for="Funcionario.Primer_Apellido" class="formulario-input" placeholder="Ingrese el apellido" />
                        </div>
                    </div>
                </div>

                <div class="formulario-row">
                    <!-- SEGUNDO APELLIDO -->
                    <div class="formulario-form-group">
                        <label class="formulario-label">Segundo Apellido</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-user-tag"></i>
                            <input asp-for="Funcionario.Segundo_Apellido" class="formulario-input" placeholder="Ingrese el apellido" />
                        </div>
                    </div>

                    <!-- FECHA NACIMIENTO -->
                    <div class="formulario-form-group">
                        <label class="formulario-label">Fecha de Nacimiento</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-calendar"></i>
                            <input asp-for="Funcionario.Fecha_Nacimiento" type="date" class="formulario-input" />
                        </div>
                    </div>
                </div>

                <div class="formulario-row">
                    <!-- CORREO -->
                    <div class="formulario-form-group">
                        <label class="formulario-label">Correo Institucional</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-envelope"></i>
                            <input asp-for="Funcionario.CorreoInstitucional" class="formulario-input" placeholder="usuario@cuc.cr" />
                        </div>
                    </div>

                    <!-- TIPO FUNCIONARIO -->
                    <div class="formulario-form-group">
                        <label class="formulario-label">Tipo de Funcionario</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-briefcase"></i>
                            <select asp-for="Funcionario.Id_Tipo_Funcionario"
                                    asp-items="Model.TiposFuncionario"
                                    class="formulario-select"></select>
                        </div>
                    </div>
                </div>

                <!-- DEPENDENCIA -->
                <div class="formulario-form-group">
                    <label class="formulario-label">Dependencia</label>
                    <div class="formulario-input-wrapper">
                        <i class="fas fa-building"></i>
                        <select asp-for="Funcionario.Id_Dependencia"
                                asp-items="Model.Dependencias"
                                class="formulario-select"></select>
                    </div>
                </div>

                <!-- BOTÓN SUBMIT -->
                <div class="formulario-buttons">
                    <button type="submit" class="formulario-btn formulario-btn-primary">
                        <i class="fas fa-save me-2"></i> Registrar Funcionario
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<script>
    function previewImage(event) {
        const img = document.getElementById("previewFoto");
        img.src = URL.createObjectURL(event.target.files[0]);
        img.style.objectFit = "cover";
    }
</script>