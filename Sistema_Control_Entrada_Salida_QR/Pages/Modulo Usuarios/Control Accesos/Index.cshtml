@page
@model Sistema_Control_Entrada_Salida_QR.Pages.Modulo_Usuarios.Control_Accesos.IndexModel
@{
    Layout = "Layout_Plantilla";
}

<link href="~/css/registros_pendientes.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="registro-container">

    <div class="registro-title">
        Mis Accesos
    </div>

    <div class="registro-mensaje" style="margin-top: 0; margin-bottom: 2rem;">
        <h4>@Model.NombreCompleto</h4>
        <p style="margin-bottom: 0.2rem;"><strong>Identificación:</strong> @Model.Identificacion</p>
        <p style="margin-bottom: 0;"><strong>Carrera / Programa:</strong> @Model.CarreraPrograma</p>
    </div>

    <div class="row text-center mb-4 g-3">
        <div class="col-12 col-md-4">
            <div class="registro-mensaje" style="background: var(--light-gray); border: 1px solid var(--border-gray);">
                <h5>Total Accesos</h5>
                <span style="font-size: 1.8rem; font-weight: 700;">@Model.TotalAccesos</span>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="registro-mensaje mensaje-exito">
                <h5>Autorizados</h5>
                <span style="font-size: 1.8rem; font-weight: 700; color: #28a745;">@Model.TotalAutorizados</span>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="registro-mensaje mensaje-error">
                <h5>Rechazados</h5>
                <span style="font-size: 1.8rem; font-weight: 700; color: #dc3545;">@Model.TotalRechazados</span>
            </div>
        </div>
    </div>

    <div class="registro-mensaje" style="margin-bottom: 2rem;">
        <h4 style="font-weight: 600; color: var(--text-dark); margin-top: 0;">Filtro</h4>
        <form method="get">

            <div class="row mb-3 g-3">
                <div class="col-12 col-md-4">
                    <label class="registro-label">Fecha Inicio</label>
                    <input type="date" name="FechaInicio" class="registro-input"
                           value="@(Model.FechaInicio?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="col-12 col-md-4">
                    <label class="registro-label">Fecha Fin</label>
                    <input type="date" name="FechaFin" class="registro-input"
                           value="@(Model.FechaFin?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="col-12 col-md-4">
                    <label class="registro-label">Estado</label>
                    <select name="FiltroEstado" class="registro-select">
                        <option value="">-- Todos --</option>
                        @foreach (var estado in Model.ListaEstados)
                        {
                            <option value="@estado.ID_Estado"
                                    selected="@(Model.FiltroEstado == estado.ID_Estado)">
                                @estado.Nombre_Estado
                            </option>
                        }
                    </select>
                </div>
            </div>

            <button type="submit" class="registro-btn registro-btn-primary">
                <i class="fas fa-filter me-2"></i> Filtrar
            </button>
        </form>
    </div>

    <h4 style="font-weight: 600; color: var(--text-dark); margin-bottom: 1rem;">Histórico de Accesos</h4>
    <div class="registro-tabla-wrapper">
        <table class="registro-table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Hora</th>
                    <th>Estado</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.ListaAccesos != null && Model.ListaAccesos.Any())
                {
                    foreach (var item in Model.ListaAccesos)
                    {
                        <tr>
                            <td>@item.Fecha_Acceso.ToString("dd/MM/yyyy")</td>
                            <td>@item.Fecha_Acceso.ToString("hh:mm tt")</td>
                            <td>
                                @if (item.ID_Estado.Trim() == "AU")
                                {
                                    <span class="registro-btn-success" style="padding: 0.3rem 0.6rem; font-size: 0.85rem;">Autorizado</span>
                                }
                                else if (item.ID_Estado.Trim() == "R")
                                {
                                    <span class="registro-btn-danger" style="padding: 0.3rem 0.6rem; font-size: 0.85rem;">Rechazado</span>
                                }
                                else
                                {
                                    <span class="registro-btn-danger" style="padding: 0.3rem 0.6rem; font-size: 0.85rem;">@item.ID_Estado.Trim()</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center">Usuario sin registro de acceso.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>