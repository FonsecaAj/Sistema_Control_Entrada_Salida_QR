@page
@model Sistema_Control_Entrada_Salida_QR.Pages.Modulo_Usuarios.Panel_Encargados_legales.IndexModel
@{
    Layout = "Layout_Plantilla";
}

<link rel="stylesheet" href="~/css/formularios_registros.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<div class="formulario-body formulario-no-bg">
    <div class="formulario-container" style="max-width: 720px;">

        <!-- ENCABEZADO -->
        <div class="formulario-header">
            <h1>Registro de Encargado Legal</h1>
            <div class="formulario-badge">
                FORMULARIO DE INGRESO
            </div>
        </div>

        <div class="formulario-body-content">

            <!-- MENSAJE SUPERIOR -->
            @if (!string.IsNullOrEmpty(Model.Encargado_Legal?.Mensaje))
            {
                if (Model.Encargado_Legal.Mensaje.Contains("Exitoso") || Model.Encargado_Legal.Mensaje.Contains("exitoso"))
                {
                    <div class="formulario-alert formulario-alert-success">
                        @Model.Encargado_Legal.Mensaje
                    </div>
                }
                else
                {
                    <div class="formulario-alert formulario-alert-danger">
                        @Model.Encargado_Legal.Mensaje
                    </div>
                }
            }

            <!-- VALIDACIONES -->
            <div asp-validation-summary="ModelOnly" class="formulario-alert formulario-alert-danger"></div>

            <form method="post" enctype="multipart/form-data">

                <!-- FOTO CIRCULAR -->
                <div class="formulario-foto-container">
                    <div class="formulario-foto-preview">
                        <img id="previewEncargado" src="https://cdn-icons-png.flaticon.com/512/3177/3177440.png" />
                    </div>

                    <label class="formulario-foto-btn">
                        <i class="fas fa-camera"></i>
                        <span>Subir Foto</span>
                        <input asp-for="FotoFile" type="file" accept="image/*"
                               class="formulario-file-input"
                               onchange="previewImageEncargado(event)" />
                    </label>
                </div>

                <!-- FILA 1 -->
                <div class="formulario-row">

                    <!-- Identificación Estudiante -->
                    <div class="formulario-form-group">
                        <label class="formulario-label">Identificación Estudiante</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-user"></i>
                            <input asp-for="Encargado_Legal.Identificacion_Estudiante"
                                   class="formulario-input"
                                   readonly="true" />
                        </div>
                    </div>

                    <!-- Nombre -->
                    <div class="formulario-form-group">
                        <label class="formulario-label">Nombre</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-user"></i>
                            <input asp-for="Encargado_Legal.Nombre" class="formulario-input" />
                        </div>
                    </div>
                </div>

                <!-- FILA 2 -->
                <div class="formulario-row">

                    <!-- Primer Apellido -->
                    <div class="formulario-form-group">
                        <label class="formulario-label">Primer Apellido</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-user"></i>
                            <input asp-for="Encargado_Legal.Primer_Apellido" class="formulario-input" />
                        </div>
                    </div>

                    <!-- Segundo Apellido -->
                    <div class="formulario-form-group">
                        <label class="formulario-label">Segundo Apellido</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-user"></i>
                            <input asp-for="Encargado_Legal.Segundo_Apellido" class="formulario-input" />
                        </div>
                    </div>
                </div>

                <!-- FILA 3 -->
                <div class="formulario-row">

                    <!-- Tipo Identificación -->
                    <div class="formulario-form-group">
                        <label class="formulario-label">Tipo de Identificación</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-id-card"></i>
                            <select asp-for="Encargado_Legal.ID_Tipo_Identificacion"
                                    asp-items="Model.TiposIdentificacion"
                                    class="formulario-select">
                                <option value="">Seleccione</option>
                            </select>
                        </div>
                    </div>

                    <!-- Identificación encargado -->
                    <div class="formulario-form-group">
                        <label class="formulario-label">Identificación Encargado</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-hashtag"></i>
                            <input asp-for="Encargado_Legal.Identificacion" class="formulario-input" />
                        </div>
                    </div>

                </div>

                <!-- FILA 4 -->
                <div class="formulario-row">

                    <!-- Teléfono -->
                    <div class="formulario-form-group">
                        <label class="formulario-label">Teléfono</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-phone"></i>
                            <input asp-for="Encargado_Legal.Telefono" class="formulario-input" />
                        </div>
                    </div>

                    <!-- Parentesco -->
                    <div class="formulario-form-group">
                        <label class="formulario-label">Parentesco</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-users"></i>
                            <select asp-for="Encargado_Legal.Id_Parentesco"
                                    asp-items="Model.Parentescos"
                                    class="formulario-select">
                                <option value="">Seleccione</option>
                            </select>
                        </div>
                    </div>

                </div>

                <!-- BOTONES -->
                <div class="formulario-buttons">
                    <button type="submit" class="formulario-btn formulario-btn-primary">
                        <i class="fas fa-user-plus me-2"></i> Registrar Encargado
                    </button>

                    <a asp-page="/Modulo Usuarios/Generacion QR/Index" class="formulario-btn formulario-btn-secondary">
                        <i class="fas fa-times me-2"></i> Cancelar
                    </a>
                </div>

            </form>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function previewImageEncargado(event) {
            const img = document.getElementById("previewEncargado");
            img.src = URL.createObjectURL(event.target.files[0]);
            img.style.objectFit = "cover";
        }
    </script>
}
