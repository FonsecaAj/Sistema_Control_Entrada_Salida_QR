@page
@model Sistema_Control_Entrada_Salida_QR.Pages.Modulo_Usuarios.Panel_Encargados_temporales.IndexModel
@{
    Layout = "Layout_Plantilla";
}

<link rel="stylesheet" href="~/css/formularios_registros.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<div class="formulario-body formulario-no-bg">
    <div class="formulario-container" style="max-width: 720px;">

        <div class="formulario-header">
            <h1>Registro de Encargado Temporal</h1>
            <div class="formulario-badge">
                FORMULARIO DE INGRESO
            </div>
        </div>

        <div class="formulario-body-content">

            @if (!string.IsNullOrEmpty(Model.Encargado_Temporal?.Mensaje))
            {
                if (Model.Encargado_Temporal.Mensaje.Contains("Exitoso") || Model.Encargado_Temporal.Mensaje.Contains("exitoso"))
                {
                    <div class="formulario-alert formulario-alert-success">
                        @Model.Encargado_Temporal.Mensaje
                    </div>
                }
                else
                {
                    <div class="formulario-alert formulario-alert-danger">
                        @Model.Encargado_Temporal.Mensaje
                    </div>
                }
            }

            <div asp-validation-summary="ModelOnly" class="formulario-alert formulario-alert-danger"></div>

            <form method="post" enctype="multipart/form-data">

                <div class="formulario-foto-container">
                    <div class="formulario-foto-preview">
                        <img id="previewEncargadoTemp" src="https://cdn-icons-png.flaticon.com/512/3177/3177440.png" />
                    </div>

                    <label class="formulario-foto-btn">
                        <i class="fas fa-camera"></i>
                        <span>Subir Foto</span>
                        <input asp-for="FotoFile" type="file" accept="image/*"
                               class="formulario-file-input"
                               onchange="previewImageEncargadoTemp(event)" />
                    </label>
                </div>

                <div class="formulario-row">

                    <div class="formulario-form-group">
                        <label class="formulario-label">Identificación Estudiante</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-user"></i>
                            <input asp-for="Encargado_Temporal.Identificacion_Estudiante"
                                   class="formulario-input"
                                   readonly="true" />
                        </div>
                    </div>

                    <div class="formulario-form-group">
                        <label class="formulario-label">Nombre</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-user"></i>
                            <input asp-for="Encargado_Temporal.Nombre" class="formulario-input" />
                        </div>
                    </div>
                </div>

                <div class="formulario-row">

                    <div class="formulario-form-group">
                        <label class="formulario-label">Primer Apellido</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-user"></i>
                            <input asp-for="Encargado_Temporal.Primer_Apellido" class="formulario-input" />
                        </div>
                    </div>

                    <div class="formulario-form-group">
                        <label class="formulario-label">Segundo Apellido</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-user"></i>
                            <input asp-for="Encargado_Temporal.Segundo_Apellido" class="formulario-input" />
                        </div>
                    </div>
                </div>

                <div class="formulario-row">

                    <div class="formulario-form-group">
                        <label class="formulario-label">Tipo de Identificación</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-id-card"></i>
                            <select asp-for="Encargado_Temporal.ID_Tipo_Identificacion"
                                    asp-items="Model.TiposIdentificacion"
                                    class="formulario-select">
                                <option value="">Seleccione</option>
                            </select>
                        </div>
                    </div>

                    <div class="formulario-form-group">
                        <label class="formulario-label">Identificación Encargado</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-hashtag"></i>
                            <input asp-for="Encargado_Temporal.Identificacion" class="formulario-input" />
                        </div>
                    </div>

                </div>

                <div class="formulario-row">

                    <div class="formulario-form-group">
                        <label class="formulario-label">Teléfono</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-phone"></i>
                            <input asp-for="Encargado_Temporal.Telefono" class="formulario-input" />
                        </div>
                    </div>

                    <div class="formulario-form-group">
                        <label class="formulario-label">Parentesco</label>
                        <div class="formulario-input-wrapper">
                            <i class="fas fa-users"></i>
                            <select asp-for="Encargado_Temporal.Id_Parentesco"
                                    asp-items="Model.Parentescos"
                                    class="formulario-select">
                                <option value="">Seleccione</option>
                            </select>
                        </div>
                    </div>

                </div>

                <div class="formulario-buttons">
                    <button type="submit" class="formulario-btn formulario-btn-primary">
                        <i class="fas fa-user-plus me-2"></i> Registrar Encargado Temporal
                    </button>

                    <a asp-page="/Modulo Usuarios/Generacion QR/Index" class="formulario-btn formulario-btn-secondary">
                        <i class="fas fa-times me-2"></i> Cancelar
                    </a>
                </div>

            </form>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function previewImageEncargadoTemp(event) {
            const img = document.getElementById("previewEncargadoTemp");
            img.src = URL.createObjectURL(event.target.files[0]);
            img.style.objectFit = "cover";
        }
    </script>
}