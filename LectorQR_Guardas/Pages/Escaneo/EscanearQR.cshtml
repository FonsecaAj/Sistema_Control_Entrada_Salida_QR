@page
@model LectorQR_Guardas.Pages.Escaneo.EscanearQRModel
@{
    ViewData["Title"] = "Escanear QR";
}

<div class="container mt-4 text-center">
    <h2>Escanear Código QR</h2>

    <div id="reader" style="width: 100%; max-width: 350px; margin: 0 auto;"></div>
    <p class="mt-3" id="estadoCamara">Iniciando cámara...</p>
</div>

<script src="https://unpkg.com/html5-qrcode"></script>

<script>
    function onScanSuccess(decodedText, decodedResult) {

        fetch("/Escaneo/EscanearQR?handler=ValidarQR", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ qr: decodedText })
        })
        .then(r => r.json())
        .then(data => {
            if (data.redirectUrl) {
                window.location.href = data.redirectUrl;
            }
        });
    }

    const qr = new Html5Qrcode("reader");

    qr.start(
        { facingMode: "environment" },
        { fps: 10, qrbox: 250 },
        onScanSuccess
    ).catch(err => {
        document.getElementById("estadoCamara").innerText =
            "Error iniciando cámara: " + err;
    });
</script>
