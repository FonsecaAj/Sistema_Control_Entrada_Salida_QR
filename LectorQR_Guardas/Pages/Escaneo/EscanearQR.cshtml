@page
@model LectorQR_Guardas.Pages.Escaneo.EscanearQRModel
@{
    ViewData["Title"] = "Escanear QR";
}

@section Styles {
    <link rel="stylesheet" href="~/css/qr-guardas.css" />
}

<div class="qr-wrapper">


    <div class="qr-main-card">
        <div class="qr-main-card-header d-flex align-items-center justify-content-center">
            <img src="~/images/logocuc.png" alt="Logo CUC" class="qr-logo me-2" />
            <h2 class="mb-0">Lector código QR</h2>
        </div>

        <div class="qr-main-card-body text-center">
            <div class="qr-reader-box">
                <div id="reader"></div>
            </div>

            <p class="mt-2" id="estadoCamara">Iniciando cámara...</p>

            <div id="resultado" class="mt-4"></div>
        </div>
    </div>

 
    <div class="qr-stats-wrapper">
        <div class="qr-stats-card">
            <h4 class="qr-stats-title">Estadísticas de Hoy</h4>

            <div class="row text-center mt-2" id="panel-estadisticas">
                <div class="col-md-3 col-6 mb-3">
                    <div class="qr-stat-box">
                        <h5 id="stat-total">0</h5>
                        <p>Total Escaneos</p>
                    </div>
                </div>
                <div class="col-md-3 col-6 mb-3">
                    <div class="qr-stat-box">
                        <h5 id="stat-aceptados">0</h5>
                        <p>Ingresos Aceptados</p>
                    </div>
                </div>
                <div class="col-md-3 col-6 mb-3">
                    <div class="qr-stat-box">
                        <h5 id="stat-rechazados">0</h5>
                        <p>Ingresos Rechazados</p>
                    </div>
                </div>
                <div class="col-md-3 col-6 mb-3">
                    <div class="qr-stat-box">
                        <h6 id="stat-ultimo">--</h6>
                        <p>Último Escaneo</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode"></script>

    <script>
        // =========================
        // Construir tarjetas de encargados
        // =========================
        function construirCardsEncargados(titulo, lista) {
            if (!lista || lista.length === 0) return "";

            let html = `<h5 class="mt-4">${titulo}</h5>`;
            html += `<div class="row justify-content-center">`;

            lista.forEach(e => {
                html += `
        <div class="col-md-4 mt-3">
            <div class="card p-3 text-start">
                ${e.foto ? `<img src="${e.foto}" class="card-img-top mb-2" style="max-height: 150px; object-fit: cover;" />` : ""}
                <p><b>Nombre:</b> ${e.nombre}</p>
                <p><b>Identificación:</b> ${e.identificacion}</p>
                <p><b>Parentesco:</b> ${e.parentesco}</p>
                <p><b>Teléfono:</b> ${e.telefono}</p>
            </div>
        </div>`;
            });

            html += `</div>`;
            return html;
        }

        // =========================
        // Mostrar resultado del escaneo
        // =========================
        function mostrarResultado(data) {
            const div = document.getElementById("resultado");

            if (data.error) {
                div.innerHTML = `<div class="alert alert-danger">${data.error}</div>`;
                document.getElementById("estadoCamara").innerText = "Código QR inválido.";
                return;
            }

            document.getElementById("estadoCamara").innerText = "QR leído correctamente.";

            let htmlPersona = `
        <div class="card p-4 text-start" style="max-width: 480px; margin: 0 auto;">
            <div class="d-flex flex-column align-items-center">
                ${data.fotoPersona ? `<img src="${data.fotoPersona}" class="mb-3 rounded-circle" style="width:120px; height:120px; object-fit:cover;" />` : ""}
                <h4 class="text-center">${data.nombre}</h4>
            </div>
            <p class="mt-3"><b>Identificación:</b> ${data.identificacion}</p>
            <p><b>Carrera / Programa / Dependencia:</b> ${data.carreraPrograma}</p>
            <p><b>Vigencia:</b> ${data.vigencia}</p>
            <p><b>Estado:</b> ${data.estado}</p>
            <p><b>Tipo:</b> ${data.tipo}</p>

            <div class="text-center mt-3">
                <button class="btn qr-btn-authorizar me-2"
                        onclick="procesarAcceso('A', '${data.identificacion}')">
                    Autorizar
                </button>
                <button class="btn qr-btn-rechazar"
                        onclick="procesarAcceso('R', '${data.identificacion}')">
                    Rechazar
                </button>
            </div>
        </div>
        `;

            let htmlEncargados = "";

            if (data.esMenorEdad) {
                htmlEncargados += construirCardsEncargados("Encargados legales", data.encargadosLegales);
                htmlEncargados += construirCardsEncargados("Encargados legales temporales", data.encargadosTemporales);
            }

            div.innerHTML = htmlPersona + htmlEncargados;
        }

        // =========================
        // Cargar estadísticas del día
        // =========================
        function cargarEstadisticas() {
            fetch("/Escaneo/EscanearQR?handler=EstadisticasHoy")
                .then(r => r.json())
                .then(data => {
                    document.getElementById("stat-total").innerText = data.totalEscaneos;
                    document.getElementById("stat-aceptados").innerText = data.ingresosAceptados;
                    document.getElementById("stat-rechazados").innerText = data.ingresosRechazados;
                    document.getElementById("stat-ultimo").innerText = data.ultimoEscaneo;
                })
                .catch(err => {
                    console.error("Error al cargar estadísticas:", err);
                });
        }

        // =========================
        // Autorizar / Rechazar
        // =========================
        function procesarAcceso(accion, identificacion) {
            fetch("/Escaneo/EscanearQR?handler=ProcesarAcceso", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: new URLSearchParams({ accion, identificacion })
            })
                .then(r => r.json())
                .then(data => {
                    if (data.error) {
                        alert(data.error);
                        return;
                    }

                    alert(data.mensaje);

                    // Limpiar resultado y volver a estado de espera
                    document.getElementById("resultado").innerHTML = "";
                    document.getElementById("estadoCamara").innerText = "Escanea el Código QR";

                    // Actualizar estadísticas
                    cargarEstadisticas();
                })
                .catch(err => {
                    console.error(err);
                    alert("Error al registrar el acceso.");
                });
        }

        // =========================
        // Éxito de lectura de QR
        // =========================
        function onScanSuccess(decodedText, decodedResult) {
            fetch("/Escaneo/EscanearQR?handler=ValidarQR", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: new URLSearchParams({ qr: decodedText })
            })
                .then(r => r.json())
                .then(data => {
                    mostrarResultado(data);
                })
                .catch(err => {
                    console.error(err);
                    document.getElementById("resultado").innerHTML =
                        `<div class="alert alert-danger">Error al validar el código.</div>`;
                });
        }

        // =========================
        // Inicializar lector y estadísticas
        // =========================
        const qr = new Html5Qrcode("reader");

        qr.start(
            { facingMode: "environment" },
            { fps: 10, qrbox: 250 },
            onScanSuccess
        ).then(_ => {
            document.getElementById("estadoCamara").innerText =
                "Escanea el Código QR";
        }).catch(err => {
            document.getElementById("estadoCamara").innerText =
                "Error iniciando cámara: " + err;
        });

        cargarEstadisticas();
    </script>
}
